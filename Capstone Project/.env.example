# Copy this file to .env to configure the app.

# ---------- Frontend ----------
# true  -> serve data from src/data/mockData.js (frontend-only demo)
# false -> call the real Express + MongoDB backend
VITE_USE_MOCK=false
# Base URL of the API. "/api" goes through the Vite dev proxy to http://localhost:5050
VITE_API_URL=/api

# ---------- Backend ----------
PORT=5050
# Leave MONGODB_URI empty to use the bundled MongoDB server (data in server/.mongodata).
# Set it to use your own MongoDB (local install or MongoDB Atlas) instead:
# MONGODB_URI=mongodb://localhost:27017/campus_events
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/campus_events
# Port the bundled MongoDB prefers (a free one is picked if it is busy):
# EMBEDDED_MONGO_PORT=27018
